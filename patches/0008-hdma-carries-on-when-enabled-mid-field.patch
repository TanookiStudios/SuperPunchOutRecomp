diff --git a/runner/src/snes/dma.c b/runner/src/snes/dma.c
index 9fb6639..f54dbfb 100644
--- a/runner/src/snes/dma.c
+++ b/runner/src/snes/dma.c
@@ -370,10 +370,20 @@ static void dma_hdmaLoadDescriptor(Dma* dma, DmaChannel* ch) {
   ch->doTransfer = !ch->terminated;
 }
 
+int g_dma_hdma_midframe_inert;
+
 void dma_initHdma(Dma* dma) {
   for (int i = 0; i < 8; i++) {
     DmaChannel* ch = &dma->channel[i];
-    if (!ch->hdmaActive) continue;
+    if (!ch->hdmaActive) {
+      if (g_dma_hdma_midframe_inert == 2) {
+        /* A channel that is off at the top of the field is not "ended" and
+         * has nothing to transfer yet; it keeps its table position. */
+        ch->doTransfer = false;
+        ch->terminated = false;
+      }
+      continue;
+    }
     dma->hdmaPendingInit &= (uint8_t)~(1u << i);
     ch->tableAdr = ch->aAdr;
     dma_hdmaLoadDescriptor(dma, ch);
@@ -410,10 +420,23 @@ void dma_doHdma(Dma* dma) {
      * $420C at line 21 and whose first HDMA write of $212C lands on line 23. */
     if (dma->hdmaPendingInit & (1u << i)) {
       dma->hdmaPendingInit &= (uint8_t)~(1u << i);
-      ch->tableAdr = ch->aAdr;
-      dma_hdmaLoadDescriptor(dma, ch);
-      ch->offIndex = 0;
-      continue;
+      if (g_dma_hdma_midframe_inert == 2) {
+        /* Switched on after the top of the field without a fresh start: the
+         * channel carries on from the table position and line counter it was
+         * left with (how Snes9x behaves, and what this game relies on). */
+      } else if (g_dma_hdma_midframe_inert) {
+        /* Hardware only initializes HDMA at the top of the field: a channel
+         * switched on later stays idle until the next field. */
+        ch->terminated = true;
+        ch->doTransfer = false;
+        continue;
+      }
+      if (g_dma_hdma_midframe_inert != 2) {
+        ch->tableAdr = ch->aAdr;
+        dma_hdmaLoadDescriptor(dma, ch);
+        ch->offIndex = 0;
+        continue;
+      }
     }
     if (ch->terminated) continue;
 
