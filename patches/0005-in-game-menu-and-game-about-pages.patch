+/* Menu navigation from the pad: d-pad / left stick, A to accept, B to go back,
+ * with hold-to-repeat. */
+static void RtPadNav(uint32 *prev, uint32 *held_since, uint32 *last_repeat) {
+  static const struct { uint32 bit; int in; } kMap[] = {
+    { SNES_PAD_UP, RECOMP_RUNTIME_UI_INPUT_UP },     { SNES_PAD_DOWN, RECOMP_RUNTIME_UI_INPUT_DOWN },
+    { SNES_PAD_LEFT, RECOMP_RUNTIME_UI_INPUT_LEFT }, { SNES_PAD_RIGHT, RECOMP_RUNTIME_UI_INPUT_RIGHT },
+    { SNES_PAD_A, RECOMP_RUNTIME_UI_INPUT_ACCEPT },  { SNES_PAD_B, RECOMP_RUNTIME_UI_INPUT_BACK },
+  };
+  const uint32 now = SDL_GetTicks();
+  const uint32 pad = OverlayNavInputs();
+  for (size_t i = 0; i < sizeof(kMap) / sizeof(kMap[0]); ++i) {
+    const uint32 bit = kMap[i].bit;
+    const bool down = (pad & bit) != 0, was = (*prev & bit) != 0;
+    const bool movement = i < 4;
+    if (down && !was) {
+      recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)kMap[i].in, 1, 0);
+      if (movement) { *held_since = now; *last_repeat = now; }
+    } else if (down && movement && now - *held_since >= SNES_OVL_REPEAT_DELAY &&
+               now - *last_repeat >= SNES_OVL_REPEAT_RATE) {
+      recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)kMap[i].in, 1, 1);
+      *last_repeat = now;
+    }
+  }
+  *prev = pad;
+}
+
+static void RunRuntimeMenuLoop(bool *running) {
+  if (!RtEnsureMenu()) return;
+  host_report_breadcrumb("in-game menu OPEN - guest frozen until it closes (Esc, or Resume)");
+  const char *dump = HostGetenv("RUNTIME_MENU_DUMP");
+  /* Test hook: semantic inputs, one every 4 pumps, e.g. "down,down,accept". */
+  const char *script = HostGetenv("RUNTIME_MENU_SCRIPT");
+  g_overlay_modal = true;
+  SetAudioPaused(true);
+  snesrecomp_sdl_show_cursor(true);
+  recomp_runtime_ui_set_backdrop(g_rtui, RECOMP_RUNTIME_UI_DEFAULT_DIM, 1.0f);
+  recomp_runtime_ui_open(g_rtui);
+  uint32 prev = OverlayNavInputs(), held_since = 0, last_repeat = 0;
+  unsigned frames = 0;
+  while (recomp_runtime_ui_is_open(g_rtui) && *running) {
+    RtPumpEvents(running);
+    RtPadNav(&prev, &held_since, &last_repeat);
+    if (script && frames % 4 == 0 && frames / 4 < 64) {
+      const char *p = script;
+      for (unsigned n = frames / 4; n > 0 && p; --n) { p = strchr(p, ','); if (p) ++p; }
+      if (p && *p) {
+        int in = -1;
+        if (!strncmp(p, "down", 4)) in = RECOMP_RUNTIME_UI_INPUT_DOWN;
+        else if (!strncmp(p, "up", 2)) in = RECOMP_RUNTIME_UI_INPUT_UP;
+        else if (!strncmp(p, "left", 4)) in = RECOMP_RUNTIME_UI_INPUT_LEFT;
+        else if (!strncmp(p, "right", 5)) in = RECOMP_RUNTIME_UI_INPUT_RIGHT;
+        else if (!strncmp(p, "accept", 6)) in = RECOMP_RUNTIME_UI_INPUT_ACCEPT;
+        else if (!strncmp(p, "back", 4)) in = RECOMP_RUNTIME_UI_INPUT_BACK;
+        if (in >= 0) recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)in, 1, 0);
+      }
+    }
+    PresentFrozenWithRuntimeMenu(frames == 40 ? dump : NULL);
+    if (HostGetenv("RUNTIME_MENU_SELFTEST") && frames >= (script ? 120u : 45u))
+      recomp_runtime_ui_close(g_rtui);
+    SDL_Delay(8);
+    frames++;
+  }
+  recomp_runtime_ui_close(g_rtui);
+  snesrecomp_sdl_show_cursor(g_cursor);
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  OverlayNoteClosed();
+  host_report_breadcrumb("in-game menu CLOSED after %u pumps - guest resuming", frames);
+  GameReset();
+}
