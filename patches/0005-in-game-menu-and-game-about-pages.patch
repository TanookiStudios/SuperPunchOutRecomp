+/* The frozen game with the menu over it. */
+static void PresentFrozenWithRuntimeMenu(const char *dump_path) {
+  int ow = 0, oh = 0;
+  if (g_renderer_funcs.GetOutputSize) g_renderer_funcs.GetOutputSize(&ow, &oh);
+  if (ow <= 0 || oh <= 0) SDL_GetWindowSize(g_window, &ow, &oh);
+  const uint32_t *overlay = snes_rtmenu_gl_render(g_rtui, ow, oh);
+  if (overlay && dump_path) RtDump(dump_path, overlay, ow, oh);
+  g_rt_overlay_pixels = overlay;
+  g_rt_overlay_w = ow;
+  g_rt_overlay_h = oh;
+  const int draw_w = (g_frozen_w > 0 ? g_frozen_w : g_snes_width) * 2;
+  const int draw_h = (g_frozen_h > 0 ? g_frozen_h : g_snes_height) * 2;
+  uint8 *pixel_buffer = 0;
+  int pitch = 0;
+  g_renderer_funcs.BeginDraw(draw_w, draw_h, &pixel_buffer, &pitch);
+  if (pixel_buffer) {
+    if (g_frozen_w > 0 && g_frozen_h > 0)
+      snes_ovl_upscale_frame(pixel_buffer, pitch, draw_w, draw_h,
+                             (const uint32_t *)g_frozen_frame, g_frozen_w * 4,
+                             g_frozen_w, g_frozen_h);
+    else
+      memset(pixel_buffer, 0, (size_t)draw_h * (size_t)pitch);
+  }
+  g_renderer_funcs.EndDraw();
+  g_rt_overlay_pixels = NULL;
+}
+
+static int RtKeyToInput(int key) {
+  switch (key) {
+  case SDLK_UP: return RECOMP_RUNTIME_UI_INPUT_UP;
+  case SDLK_DOWN: return RECOMP_RUNTIME_UI_INPUT_DOWN;
+  case SDLK_LEFT: return RECOMP_RUNTIME_UI_INPUT_LEFT;
+  case SDLK_RIGHT: return RECOMP_RUNTIME_UI_INPUT_RIGHT;
+  case SDLK_RETURN: case SDLK_KP_ENTER: case SDLK_SPACE: return RECOMP_RUNTIME_UI_INPUT_ACCEPT;
+  case SDLK_BACKSPACE: return RECOMP_RUNTIME_UI_INPUT_BACK;
+  default: return -1;
+  }
+}
+
+static void RtPumpEvents(bool *running) {
+  SDL_Event event;
+  int ww = 0, wh = 0;
+  SDL_GetWindowSize(g_window, &ww, &wh);
+  while (SDL_PollEvent(&event)) {
+    if (HandleDeviceEvent(&event)) continue;
+    switch (event.type) {
+    case SDL_QUIT:
+      *running = false;
+      break;
+    case SDL_KEYDOWN: {
+      const int key = SNESRECOMP_SDL_EVENT_KEY(event);
+      if (key == SDLK_ESCAPE) { recomp_runtime_ui_close(g_rtui); break; }
+      const int in = RtKeyToInput(key);
+      if (in >= 0)
+        recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)in, 1,
+                                       SNESRECOMP_SDL_EVENT_REPEAT(event) ? 1 : 0);
+      break;
+    }
+    case SDL_KEYUP:
+      /* A key held across the close must not stay down in the guest. */
+      HandleInput(SNESRECOMP_SDL_EVENT_KEY(event), SNESRECOMP_SDL_EVENT_MOD(event), false);
+      break;
+    case SDL_MOUSEMOTION:
+      if (ww > 0 && wh > 0 && g_rt_overlay_w > 0)
+        snes_rtmenu_gl_mouse_pos((float)event.motion.x * g_rt_overlay_w / ww,
+                                 (float)event.motion.y * g_rt_overlay_h / wh);
+      break;
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:
+      if (event.button.button == SDL_BUTTON_LEFT)
+        snes_rtmenu_gl_mouse_button(0, event.type == SDL_MOUSEBUTTONDOWN);
+      break;
+    default:
+      break;
+    }
+  }
+}
