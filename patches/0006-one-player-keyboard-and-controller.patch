+/* A one-player game gives player 1 the keyboard AND the first controller at
+ * once, whichever the launcher's row says, so plugging a pad in just works
+ * and nobody has to find a setting. Only "None" turns the keyboard off. */
+static bool SeatReadsKeyboard(int seat) {
+  const int src = g_config.player_src[seat];
+  return src == 1 || (seat == 0 && g_game->num_players == 1 && src == 2);
+}
